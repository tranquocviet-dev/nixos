# Close / Kill active window
super + q
	bspc node -c

# Switch to desktop 1-9
super + {1-9}
	bspc desktop -f '^{1-9}'

# Send focused window to desktop 1-9
super + shift + {1-9}
	bspc node -d '^{1-9}'

# Custom wallpaper script
super + shift + w
	~/.config/scripts/setwall --pick

super + ctrl + w
	~/.config/scripts/togwall
# Application launcher
super + space
	 j4-dmenu-desktop --dmenu="bemenu -i -l 12 -p 'Apps:'"

# Area selection directly to clipboard
super + Print
	maim -s -u | xclip -selection clipboard -t image/png

# Full screen directly to clipboard
ctrl + super + Print
	maim -u | xclip -selection clipboard -t image/png

# Quit bspwm / Exit session
super + shift + Escape
	bspc quit

# Toggle focused window between floating and tiled
# super + t
# 	bspc node -t ~floating

# Toggle all windows on the current desktop between floating and tiled
super + t
	~/.config/bspwm/toggle-all

# Toggle fullscreen
super + f
	bspc node -t ~fullscreen

# Toggle pseudo-tiled (tiled position, but floating size)
super + shift + t
	bspc node -t ~pseudo_tiled

# Terminal emulator
super + Return
	kitty

alt + Tab
	rofi -show window -theme ~/.config/rofi/minimal.rasi

super + shift + z
	  boomer
