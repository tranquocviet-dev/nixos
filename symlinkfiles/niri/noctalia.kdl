layout {

    focus-ring {
        active-color   "#29a298"
        inactive-color "#fdf5e2"
        urgent-color   "#db302d"
    }

    border {
        active-color   "#29a298"
        inactive-color "#fdf5e2"
        urgent-color   "#db302d"
    }


    tab-indicator {
        active-color   "#29a298"
        inactive-color "#a5d8d4"
        urgent-color   "#db302d"
    }

    insert-hint {
        color "#29a29880"
    }
}

recent-windows {
    highlight {
        active-color "#29a298"
        urgent-color "#db302d"
    }
}
