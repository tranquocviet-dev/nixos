# Area selection directly to clipboard
key "Super+Print" sh -c "maim -s -u | xclip -selection clipboard -t image/png"

# Full screen directly to clipboard
key "Ctrl+Super+Print" sh -c "maim -u | xclip -selection clipboard -t image/png"

key "Super+q" icesh -f close

key "Alt+Tab" skippy-xd --toggle

key "Super+space" j4-dmenu-desktop --dmenu="dmenu -i -fn 'serif-12' -nb '#c0c0c0' -nf '#000000' -sb '#000000' -sf '#c0c0c0'"
