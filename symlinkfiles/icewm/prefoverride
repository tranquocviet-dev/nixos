# Disable status graphs / monitors
TaskBarShowCPUStatus=0
TaskBarShowMEMStatus=0
TaskBarShowNetStatus=0
TaskBarShowMailCheck=0

# Ensure clock stays visible
TaskBarShowClock=1
# Fix clock format and font
TimeFormat="%H:%M"
DateFormat="%Y-%m-%d %H:%M"

# DesktopBackgroundImage="/home/dice/Pictures/rin/tomorrow-night/658267.png"
DesktopBackgroundImage=""
DesktopBackgroundColor=""
# 1. Enable visual highlight outline on the active selected window
QuickSwitchOutline=1

QuickSwitch=1

# Focus window when an application requests to be raised/activated
FocusOnAppRaise=1

# Allow apps to steal focus on urgent/map events
FocusUrgent=1

TitleFontNameXft="Hack:size=10:bold"
StatusFontNameXft="Hack:size=9"
MenuFontNameXft="Hack:size=10"
ActiveButtonFontNameXft="Hack:size=9:bold"
NormalButtonFontNameXft="Hack:size=9"
ToolButtonFontNameXft="Hack:size=9"
QuickSwitchFontNameXft="Hack:size=10:bold"
