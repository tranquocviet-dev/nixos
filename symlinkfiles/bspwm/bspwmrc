#!/usr/bin/env bash

# Display configuration (run before drawing wallpaper/compositor)
xrandr --output DP-2 --mode 1920x1080 --rate 144 --dpi 96

# Environment & Input Method
export XDG_CURRENT_DESKTOP=bspwm
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx

# Systemd / D-Bus activation environment
systemctl --user import-environment DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP
dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP

# Background daemons
fcitx5 -d &
sxhkd &

# Initialize 9 numbered workspaces
bspc monitor -d 1 2 3 4 5 6 7 8 9

# Floating & appearance settings
bspc config border_width 0
bspc rule -a '*' state=floating

# Mouse bindings for floating windows (Mod + Left Click to move, Mod + Right Click to resize)
bspc config pointer_modifier mod4
bspc config pointer_action1 move
bspc config pointer_action3 resize_corner
# Float all windows by default, centered, with a consistent initial size
bspc rule -a '*' state=floating center=true rectangle=1000x650+0+0
# Wallpaper & Desktop monitoring
~/.config/scripts/setwall &
(sleep 1 && conky) &
