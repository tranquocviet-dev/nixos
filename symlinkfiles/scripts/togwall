#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/icewm"
WALLPAPER_FILE="$STATE_DIR/wallpaper"
TOGGLE_STATE="$STATE_DIR/toggle_state"
SOLID_IMAGE="$HOME/.config/icewm/wallpapers/solid.png"

mkdir -p "$STATE_DIR"

# 1. Determine the current mode
MODE="image"
if [ -s "$TOGGLE_STATE" ]; then
	MODE=$(tr -d '\r\n ' < "$TOGGLE_STATE")
fi

# 2. Toggle execution
if [ "$MODE" = "image" ]; then
	# Switch to solid color image
	if [ -f "$SOLID_IMAGE" ]; then
		xwallpaper --zoom "$SOLID_IMAGE"
	fi
	printf '%s' "solid" > "$TOGGLE_STATE"
else
	# Switch to saved wallpaper
	if [ -s "$WALLPAPER_FILE" ]; then
		IMG_PATH=$(tr -d '\r\n' < "$WALLPAPER_FILE")
		IMG_PATH="${IMG_PATH/#\~/$HOME}"
		if [ -f "$IMG_PATH" ]; then
			xwallpaper --zoom "$IMG_PATH"
			printf '%s' "image" > "$TOGGLE_STATE"
			exit 0
		fi
	fi

	# Fallback if saved wallpaper path does not exist on disk
	if [ -f "$SOLID_IMAGE" ]; then
		xwallpaper --zoom "$SOLID_IMAGE"
	fi
	printf '%s' "solid" > "$TOGGLE_STATE"
fi